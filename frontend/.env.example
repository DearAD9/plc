# Backend API & WebSocket Base URL
# Development (direct or via Vite proxy):
VITE_API_URL=http://localhost:8000

# Production Example (leave empty for reverse proxy / same-origin deployments,
# or set to the backend API host):
# VITE_API_URL=https://api.example.com
