# ==============================================================================
# Siemens PLC Snap7 Communication Service Configuration
# ==============================================================================

# Network settings for the Siemens PLC
PLC_IP=192.168.0.100
PLC_RACK=0
PLC_SLOT=1
PLC_PORT=102
PLC_TIMEOUT_MS=5000

# Polling & Reconnect intervals (in seconds)
PLC_POLL_INTERVAL=1.0
PLC_RECONNECT_INTERVAL=5.0

# Path to the JSON configuration defining PLC tags/variables to read
CONFIG_PATH=config/plc_config.json

# Server and Logging settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# Frontend Vite Settings (if running frontend from root environment)
# VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://api.example.com

